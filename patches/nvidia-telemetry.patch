-    Data.init([0x02, 0x10, 0x00, 0x00]): "AMD"
+    Data.init([0x02, 0x10, 0x00, 0x00]): "AMD",
+    Data.init([0xde, 0x10, 0x00, 0x00]): "NVIDIA"
 ]
 
+private func pciMatches(_ accMatch: String, _ pci: String) -> Bool {
+    if accMatch.range(of: pci) != nil {
+        return true
+    }
+    // third-party drivers may advertise only the vendor half, eg "0x000010de&0x0000ffff"
+    let value = accMatch.components(separatedBy: "&").first ?? ""
+    guard value.hasPrefix("0x0000"), value.count == 10 else {
+        return false
+    }
+    return value.suffix(4) == pci.suffix(4)
+}
+
 private func maxANEPower(for platform: Platform?) -> Double {
